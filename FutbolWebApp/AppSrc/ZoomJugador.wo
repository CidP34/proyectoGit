Use cWebView.pkg
Use cWebForm.pkg
Use cWebCombo.pkg
Use cWebPanel.pkg
Use cWebButton.pkg
Use cWebList.pkg
Use cWebColumn.pkg
Use cLigaDataDictionary.dd
Use cEquipoDataDictionary.dd
Use cJugadorDataDictionary.dd
Use cPosicionDataDictionary.dd
Use cJugadorPosicionDataDictionary.dd

Register_Object oSelectJugadorPosicion
Register_Object oSelectEquipo

Object oZoomJugador is a cWebView
    Set psCaption to "Jugador"
    Set peViewType to vtZoom
    Set piColumnCount to 12

    Object oLiga_DD is a cLigaDataDictionary
    End_Object

    Object oEquipo_DD is a cEquipoDataDictionary
        Set DDO_Server to oLiga_DD
    End_Object

    Object oJugador_DD is a cJugadorDataDictionary
        Set DDO_Server to oEquipo_DD
    End_Object

    Object oPosicion_DD is a cPosicionDataDictionary
    End_Object

    Object oJugadorPosicion_DD is a cJugadorPosicionDataDictionary
        Set DDO_Server to oJugador_DD
        Set DDO_Server to oPosicion_DD
        Set Constrain_File to Jugador.File_Number    // Sprint 5: solo las del jugador
    End_Object

    Set Main_DD to oJugador_DD
    Set Server to oJugador_DD

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12

        Object oJugadorNombre is a cWebForm
            Entry_Item Jugador.Nombre
            Set psLabel to "Nombre"
            Set piColumnSpan to 12
            Set psCSSClass to "CampoObligatorio"
        End_Object

        Object oJugadorApellido is a cWebForm
            Entry_Item Jugador.Apellido
            Set psLabel to "Apellido"
            Set piColumnSpan to 12
            Set psCSSClass to "CampoObligatorio"
        End_Object

        // Sprint 4 - Desplegable: se rellena solo con la tabla de validación del DD
        Object oJugadorNacionalidad is a cWebCombo
            Entry_Item Jugador.Nacionalidad
            Set psLabel to "Nacionalidad"
            Set piColumnSpan to 12
        End_Object

        // Padre: se elige navegando a su Select (nfFromChild)
        Object oEquipoNombre is a cWebForm
            Entry_Item Equipo.Nombre
            Set psLabel to "Equipo"
            Set piColumnSpan to 12
            Set pbPromptButton to True

            Procedure OnPrompt
                Send NavigateForward of oSelectEquipo Self
            End_Procedure
        End_Object

        // Sprint 5 - Abre SelectJugadorPosicion para añadir y quitar posiciones
        // (nfFromParent: jugador es padre de jugadorposicion)
        Object oEditarPosiciones is a cWebButton
            Set psCaption to "Editar posiciones"
            Set piColumnSpan to 4
            Set psCSSClass to "WebIcon_Add"

            Procedure OnClick
                Send NavigateForward of oSelectJugadorPosicion Self
            End_Procedure

            // Guarda el jugador antes de salir (si es nuevo, tiene que existir)
            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                Move True to NavigateData.bSaveBeforeNavigate
            End_Procedure

            // Al volver con «Hecho», se recarga la lista de posiciones
            Procedure OnNavigateBack Handle hoCallback tWebNavigateData NavigateData
                Send RefreshListFromDD of oPosicionesList
            End_Procedure
        End_Object

        // Sprint 5 - Posiciones de este jugador (solo consulta)
        Object oPosicionesList is a cWebList
            Set Server to oJugadorPosicion_DD
            Set piHeight to 180
            Set psPlaceHolder to "Sin posiciones asignadas"

            Object oPosicionNombre is a cWebColumn
                Entry_Item Posicion.Nombre
                Set psCaption to "Posiciones"
            End_Object
        End_Object

    End_Object

    WebRegisterPath ntNavigateForward oSelectJugadorPosicion
    WebRegisterPath ntNavigateForward oSelectEquipo
End_Object
