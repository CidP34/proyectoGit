Use cWebView.pkg
Use cWebForm.pkg
Use cWebPanel.pkg
Use cWebButton.pkg
Use cLigaDataDictionary.dd
Use cEquipoDataDictionary.dd
Use cEntrenadorDataDictionary.dd

Register_Object oSelectEquipo

Object oZoomEntrenador is a cWebView
    Set psCaption to "Entrenador"
    Set peViewType to vtZoom
    Set piColumnCount to 12

    Object oLiga_DD is a cLigaDataDictionary
    End_Object

    Object oEquipo_DD is a cEquipoDataDictionary
        Set DDO_Server to oLiga_DD
    End_Object

    Object oEntrenador_DD is a cEntrenadorDataDictionary
        Set DDO_Server to oEquipo_DD
    End_Object

    Set Main_DD to oEntrenador_DD
    Set Server to oEntrenador_DD

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12

        Object oEntrenadorNombre is a cWebForm
            Entry_Item Entrenador.Nombre
            Set psLabel to "Nombre"
            Set piColumnSpan to 12
            Set psCSSClass to "CampoObligatorio"
        End_Object

        Object oEntrenadorApellido is a cWebForm
            Entry_Item Entrenador.Apellido
            Set psLabel to "Apellido"
            Set piColumnSpan to 12
            Set psCSSClass to "CampoObligatorio"
        End_Object

        Object oEntrenadorNacionalidad is a cWebForm
            Entry_Item Entrenador.Nacionalidad
            Set psLabel to "Nacionalidad"
            Set piColumnSpan to 12
        End_Object

        // Padre: se elige navegando a su Select (nfFromChild)
        Object oEquipoNombre is a cWebForm
            Entry_Item Equipo.Nombre
            Set psLabel to "Equipo"
            Set piColumnSpan to 12
            Set pbPromptButton to True

            Procedure OnPrompt
                Send NavigateForward of oSelectEquipo Self
            End_Procedure
        End_Object

        // Sprint 4 - Null: deja al entrenador sin equipo (EquipoID = NULL)
        Object oDespedir is a cWebButton
            Set psCaption to "Despedir"
            Set piColumnSpan to 4
            Set psCSSClass to "WebIcon_Delete"

            Procedure OnClick
                Boolean bHayEntrenador bHayEquipo
                Get HasRecord of oEntrenador_DD to bHayEntrenador
                Get HasRecord of oEquipo_DD to bHayEquipo
                If (not(bHayEntrenador) or not(bHayEquipo)) Begin
                    Send ShowInfoBox "Este entrenador ya no tiene equipo"
                    Procedure_Return
                End
                // Vacía solo el DDO de Equipo (el padre); el entrenador sigue cargado
                Send Request_ClearBindingTable of oEquipoNombre
                // Al guardar sin padre, ParentNullAllowed deja EquipoID a NULL
                Send Request_Save of oZoomEntrenador
                Send ShowInfoBox "Entrenador despedido: ha quedado sin equipo"
            End_Procedure
        End_Object

    End_Object

    WebRegisterPath ntNavigateForward oSelectEquipo
End_Object
