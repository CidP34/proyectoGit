Use cWebView.pkg
Use cWebList.pkg
Use cWebColumn.pkg
Use cPosicionDataDictionary.dd

Register_Object oZoomPosicion
Register_Object oZoomJugador

Object oSelectPosicion is a cWebView
    Set psCaption to "Posiciones"
    Set peViewType to vtSelect
    Set piColumnCount to 12
    Set pbFillHeight to True

    Object oPosicion_DD is a cPosicionDataDictionary
    End_Object

    Set Main_DD to oPosicion_DD
    Set Server to oPosicion_DD

    // Desde el Dashboard también llega como nfUndefined: se distingue por la
    // vista que la invoca (ZoomJugador = asignar posición a un jugador)
    { WebProperty=Server }
    Property Boolean pbModoAsignar False

    Object oList is a cWebList
        Set pbFillHeight to True
        Set pbServerOnRowClick to True
        Set psPlaceHolder to "No hay posiciones todavía"

        Object oPosicionNombre is a cWebColumn
            Entry_Item Posicion.Nombre
            Set psCaption to "Posición"
            Set piWidth to 200
        End_Object

        Procedure OnRowClick String sRowID
            Boolean bAsignar
            WebGet pbModoAsignar of oSelectPosicion to bAsignar
            If bAsignar Begin
                Send NavigateClose Self      // devuelve la posición al jugador
            End
            Else Begin
                Send NavigateForward of oZoomPosicion Self
            End
        End_Procedure
    End_Object

    WebRegisterPath ntNavigateForward oZoomPosicion

    Procedure OnNavigateForward tWebNavigateData NavigateData Handle hoInvokingView Handle hoInvokingObject
        WebSet pbModoAsignar to (hoInvokingView = oZoomJugador)
    End_Procedure
End_Object
