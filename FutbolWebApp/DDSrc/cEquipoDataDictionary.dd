Use DataDict.pkg

Open Equipo
Open Liga
Open Jugador
Open Entrenador

Class cEquipoDataDictionary is a DataDictionary

    Procedure Construct_Object
        Forward Send Construct_Object
        Set Main_File to Equipo.File_Number

        // Sprint 4 - Clave primaria protegida: solo se asigna al crear el registro
        Set Protect_Key_State to True
        Set Key_Field_State Field Equipo.ID to True

        Set Add_Server_File to Liga.File_Number
        // LigaID es NOT NULL: todo equipo debe tener liga (valor por defecto, explícito)
        Set ParentNullAllowed Liga.File_Number to False
        // Actualización Sprint 4 - Se permite cambiar un equipo de liga después de
        // guardado; el contador Liga.Equipos (Num_Equipos) se ajusta en Backout/Update
        Set ParentNoSwitchIfCommitted Liga.File_Number to False
        Set Add_Client_File to Jugador.File_Number
        Set Add_Client_File to Entrenador.File_Number

        Set Foreign_Field_Option DD_KEYFIELD DD_NOPUT to True
        Set Foreign_Field_Option DD_KEYFIELD DD_FINDREQ to True
        Set Foreign_Field_Option DD_INDEXFIELD DD_NOPUT to True
        Set Foreign_Field_Option DD_DEFAULT DD_DISPLAYONLY to True

        Set Cascade_Delete_State to False

        Set Field_Option Field Equipo.Nombre DD_Required to True
        Set Status_Help Field Equipo.Nombre to "Nombre oficial del club"

        // Sprint 4 - Nombre (y apellido) no modificables: DD_DisplayOnly
        // (= DD_NoEnter + DD_NoPut: se ven en gris y no se pueden cambiar)
        Set Field_Option Field Equipo.Nombre DD_DisplayOnly to True
    End_Procedure

    // ------------------------------------------------------------------
    // Gestión de Liga.Equipos (Num_Equipos)
    //   Alta de equipo ............ Update  -> +1 en su liga
    //   Baja de equipo ............ Backout -> -1 en su liga
    //   Cambio de liga ............ Backout -> -1 en la liga ANTIGUA
    //                               Update  -> +1 en la liga NUEVA
    //   Edición sin cambiar liga .. Backout -1 y Update +1 en la misma (neto 0)
    // Las dos ligas se graban en la misma transacción: si Validate_Save da
    // error (liga nueva completa), se deshace todo y ningún contador cambia.
    // ------------------------------------------------------------------

    // Valores NUEVOS al guardar
    Procedure Update
        Forward Send Update
        Add 1 to Liga.Equipos
    End_Procedure

    // Valores ANTIGUOS al editar y al borrar: si el equipo cambia de liga,
    // resta en la anterior y suma en la nueva
    Procedure Backout
        Forward Send Backout
        Subtract 1 from Liga.Equipos
    End_Procedure

    // Se ejecuta después de Update: Liga.Equipos ya cuenta este equipo
    Function Validate_Save Returns Integer
        Integer iError
        Forward Get Validate_Save to iError
        If (iError <> 0) Function_Return iError
        If (Liga.Equipos > Liga.EquiposMax) Begin
            Send UserError ("La liga " + Trim(Liga.Nombre) + " ya tiene el máximo de equipos (" + String(Liga.EquiposMax) + ")")
            Function_Return 1
        End
        Function_Return 0
    End_Function

End_Class
